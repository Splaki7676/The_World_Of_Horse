<%@ Master Language="C#" MasterPageFile="~/Site1.Master" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="TheWorldOfHorses__.Admin_Master_Nested_.Admin" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">

     <style>
        .admin-layout {
            display: flex;
            min-height: 600px;
        }

        .admin-sidebar {
            width: 220px;
            background-color: #1a1a1a;
            padding: 20px 0;
            flex-shrink: 0;
        }

        .admin-sidebar h3 {
            color: white;
            text-align: center;
            font-size: 18px;
            margin-bottom: 20px;
            border-bottom: 2px solid coral;
            padding-bottom: 10px;
        }

        .admin-sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .admin-sidebar ul li a {
            display: block;
            padding: 12px 20px;
            color: #cccccc;
            text-decoration: none;
            font-size: 15px;
            transition: background 0.2s;
        }

        .admin-sidebar ul li a:hover,
        .admin-sidebar ul li a.active {
            background-color: coral;
            color: white;
        }

        .admin-main {
            flex: 1;
            padding: 30px;
            background-color: #f5f5f5;
        }

        .admin-main h2 {
            color: #1a1a1a;
            border-bottom: 2px solid coral;
            padding-bottom: 8px;
            margin-bottom: 20px;
        }
    </style>


</asp:Content>

<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">

     <div class="admin-layout">

        <div class="admin-sidebar">
            <h3>⚙️ Admin Panel</h3>
            <ul>
                <li><a runat="server" href="~/Admin_Master_Nested/AdminDashboard.aspx">🏠 Dashboard</a></li>
                <li><a runat="server" href="~/Admin_Master_Nested/AdminUsers.aspx">👥 Users</a></li>
                <li><a runat="server" href="~/Admin_Master_Nested/AdminAddUser.aspx">➕ Add User</a></li>
            </ul>
        </div>

        <div class="admin-main">
            <asp:ContentPlaceHolder ID="AdminContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var links = document.querySelectorAll(".admin-sidebar ul li a");
            var currentPage = window.location.pathname.split("/").pop();
            links.forEach(function (link) {
                var linkPage = link.getAttribute("href");
                if (linkPage && linkPage.split("/").pop() === currentPage) {
                    link.classList.add("active");
                }
            });
        });
    </script>
</asp:Content>
